--- dreamerv3/embodied/run/train.py	2026-09-17 22:57:12.086019389 -0700
+++ dreamerv3/embodied/run/train.py	2026-09-17 02:54:54.568682927 -0700
@@ -1,4 +1,5 @@
 import collections
+import re
 from functools import partial as bind
 
 import elements
@@ -87,6 +88,39 @@
   if args.from_checkpoint:
     elements.checkpoint.load(args.from_checkpoint, dict(
         agent=bind(agent.load, regex=args.from_checkpoint_regex)))
+
+  # Wrap agent.load so that extra keys saved by optional components (e.g.
+  # bc_opt from LangCondAgent when bc_separate_batch was True) are silently
+  # dropped when the current model no longer has those parameters.
+  _orig_agent_load = agent.load
+  def _tolerant_agent_load(data, regex=None):
+    if regex is None and isinstance(data, dict) and 'params' in data:
+      import numpy as _np
+      extra = {k for k in data['params'] if k not in agent.params}
+      missing = {k for k in agent.params if k not in data['params']}
+      # Shape mismatches (e.g. one extra encoder input column such as the 'finish' label): zero-pad when the new
+      # parameter is larger along exactly one axis, otherwise leave the fresh init.
+      padded, dropped = [], []
+      for k in list(data['params']):
+        if k in agent.params:
+          old_v, new_shape = data['params'][k], tuple(agent.params[k].shape)
+          if tuple(old_v.shape) != new_shape:
+            diff = [i for i in range(len(new_shape)) if old_v.shape[i] != new_shape[i]] if len(old_v.shape) == len(new_shape) else None
+            if diff and len(diff) == 1 and new_shape[diff[0]] > old_v.shape[diff[0]]:
+              pad = [(0, 0)] * len(new_shape); pad[diff[0]] = (0, new_shape[diff[0]] - old_v.shape[diff[0]])
+              data['params'][k] = _np.pad(_np.asarray(old_v), pad); padded.append(k)
+            else:
+              del data['params'][k]; missing.add(k); dropped.append(k)
+      if padded or dropped:
+        print(f'[Checkpoint] zero-padded {len(padded)} params to the new shape (e.g. {padded[:3]}); dropped {len(dropped)} shape-incompatible (e.g. {dropped[:3]}).')
+      if extra or missing:
+        print(f'[Checkpoint] Dropping {len(extra)} unknown param keys (e.g. {sorted(extra)[:3]}); '
+              f'keeping fresh init for {len(missing)} params absent from the checkpoint (e.g. {sorted(missing)[:3]}). Using partial-load path.')
+        skip = {k.split('/')[0] + '/' for k in extra} | {k.split('/')[0] + '/' for k in missing}
+        regex = '^(?!' + '|'.join(re.escape(x) for x in skip) + ').*'
+    return _orig_agent_load(data, regex=regex)
+  agent.load = _tolerant_agent_load
+
   cp.load_or_save()
 
   print('Start training loop')
